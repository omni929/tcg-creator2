{
  "name": "card-pipeline",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/card-studio",
    "build": "npm run build -w apps/card-studio",
    "preview": "npm run preview -w apps/card-studio --",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run build"
  }
}
